[Unit]
Description=Rebuild + deploy the HermesXP exe after a plugin update
After=network-online.target msn-server.service
Wants=network-online.target msn-server.service

[Service]
Type=oneshot
ExecStart=__REPO_ROOT__/local-server/update-xp.sh __REPO_ROOT__

TimeoutStartSec=240

[Install]
WantedBy=default.target
