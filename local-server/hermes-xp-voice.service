[Unit]
Description=HermesXP native MSN audio via Hermes Talk plugin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=__HOME__/.hermes/msn-bridge.env
EnvironmentFile=-__HOME__/.hermes/plugins/hermes-talk/.env
ExecStart=__HERMES_BIN__ xpvoice
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
# Talk owns provider credentials, task state and temporary session files.
# Unlike the removed read-only ASR gateway, it needs its own profile writable.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=default.target
