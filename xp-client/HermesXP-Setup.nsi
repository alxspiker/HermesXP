; HermesXP native Windows XP-compatible installer.
; The package staging directory is generated by build-xp-package.sh.
; Compile with: makensis -DINPUT_DIR=/absolute/stage -DOUTPUT_FILE=/absolute/out.exe
!include "MUI2.nsh"
!include "LogicLib.nsh"

!ifndef INPUT_DIR
  !error "Set INPUT_DIR to the generated HermesXP package staging directory"
!endif
!ifndef OUTPUT_FILE
  !error "Set OUTPUT_FILE to the desired setup executable"
!endif

Name "HermesXP"
OutFile "${OUTPUT_FILE}"
Unicode true
RequestExecutionLevel admin
InstallDir "$PROGRAMFILES\HermesXP"
InstallDirRegKey HKLM "Software\HermesXP" "InstallDir"
ShowInstDetails show
ShowUninstDetails show

!define MUI_ABORTWARNING
!define MUI_FINISHPAGE_RUN "$INSTDIR\HermesXP.exe"
!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_COMPONENTS
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "English"

Function .onInit
  SetShellVarContext all
  ; Existing users already have HermesXP and their private settings at
  ; C:\HermesXP. Upgrade in place instead of creating a second copy.
  ; Brand-new installations use Program Files.
  ReadRegStr $0 HKLM "Software\HermesXP" "InstallDir"
  ${If} $0 == ""
    IfFileExists "C:\HermesXP\HermesXP.exe" 0 legacy_done
    StrCpy $INSTDIR "C:\HermesXP"
  ${EndIf}
legacy_done:
FunctionEnd

Section "HermesXP application" SEC_MAIN
  SectionIn RO
  SetShellVarContext all
  SetOutPath "$INSTDIR"

  File "${INPUT_DIR}/HermesXP.exe"
  File "${INPUT_DIR}/README.txt"
  File "${INPUT_DIR}/ca.pem"
  File "${INPUT_DIR}/escargot.dll"
  File "${INPUT_DIR}/msnmsgr.exe-escargot.ini"
  File "${INPUT_DIR}/wlcomm.exe-escargot.ini"
  ; Preserve manually configured server addresses, credentials, and pairing.
  IfFileExists "$INSTDIR\hermesxp.ini" config_ready
  File "${INPUT_DIR}/hermesxp.ini"
config_ready:

  WriteUninstaller "$INSTDIR\Uninstall.exe"
  CreateDirectory "$SMPROGRAMS\HermesXP"
  CreateShortCut "$SMPROGRAMS\HermesXP\HermesXP.lnk" "$INSTDIR\HermesXP.exe"
  CreateShortCut "$SMPROGRAMS\HermesXP\Uninstall HermesXP.lnk" "$INSTDIR\Uninstall.exe"

  WriteRegStr HKLM "Software\HermesXP" "InstallDir" "$INSTDIR"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\HermesXP" "DisplayName" "HermesXP"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\HermesXP" "DisplayVersion" "0.2.1"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\HermesXP" "Publisher" "WM Studios"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\HermesXP" "InstallLocation" "$INSTDIR"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\HermesXP" "UninstallString" '"$INSTDIR\Uninstall.exe"'
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\HermesXP" "DisplayIcon" "$INSTDIR\HermesXP.exe"
  WriteRegDWORD HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\HermesXP" "NoModify" 1
  WriteRegDWORD HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\HermesXP" "NoRepair" 1
SectionEnd

Section "Desktop shortcut" SEC_DESKTOP
  SetShellVarContext all
  CreateShortCut "$DESKTOP\HermesXP.lnk" "$INSTDIR\HermesXP.exe"
SectionEnd

Section "Uninstall"
  SetShellVarContext all
  Delete "$DESKTOP\HermesXP.lnk"
  Delete "$SMPROGRAMS\HermesXP\HermesXP.lnk"
  Delete "$SMPROGRAMS\HermesXP\Uninstall HermesXP.lnk"
  RMDir "$SMPROGRAMS\HermesXP"
  Delete "$INSTDIR\HermesXP.exe"
  Delete "$INSTDIR\README.txt"
  Delete "$INSTDIR\ca.pem"
  Delete "$INSTDIR\escargot.dll"
  Delete "$INSTDIR\msnmsgr.exe-escargot.ini"
  Delete "$INSTDIR\wlcomm.exe-escargot.ini"
  Delete "$INSTDIR\Uninstall.exe"
  ; Never delete hermesxp.ini, screenshots, or user-created files.
  RMDir "$INSTDIR"
  DeleteRegKey HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\HermesXP"
  DeleteRegKey HKLM "Software\HermesXP"
SectionEnd
